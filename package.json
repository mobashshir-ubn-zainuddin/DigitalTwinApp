{
  "name": "room-digital-twin",
  "version": "1.0.0",
  "description": "Room Digital Twin — interactive 3D simulation of a room with AC, fan, computers and occupants",
  "main": "main.js",
  "author": "aaryannsinghparmar@gmail.com",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:all": "electron-builder -mwl"
  },
  "build": {
    "appId": "com.digitaltwin.room",
    "productName": "Room Digital Twin",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "room_digital_twin.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Room Digital Twin",
      "artifactName": "Room-Digital-Twin-Setup-x64.${ext}"
    },
    "portable": {
      "artifactName": "Room-Digital-Twin-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
